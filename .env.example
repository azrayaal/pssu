# Transport selection for the API client.
#   mock  → in-browser mock server (default, no backend required)
#   rest  → real HTTP backend
VITE_API_MODE=mock

# Base URL used when VITE_API_MODE=rest
VITE_API_BASE_URL=https://api.pssu.co.id/v1

# Optional: fraction of mock GET requests that fail, for exercising error states.
# Example: 0.15 makes roughly 15% of reads fail.
VITE_MOCK_FAILURE_RATE=0
